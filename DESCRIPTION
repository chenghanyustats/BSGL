Package: BSGL
Type: Package
Title: Bayesian Spatial Group Lasso for Spatially Varying Coefficient Models
Version: 0.1.0
Authors@R: c(
    person("Qishi", "Zhan", role = c("aut", "cre"), email = "qishi.zhan@example.com")
